# Copie ce fichier en .env.local pour le développement, et ajoute les mêmes
# variables dans Vercel (Project → Settings → Environment Variables).

# Stripe (dashboard.stripe.com → Développeurs → Clés API)
STRIPE_SECRET_KEY="sk_live_..."
# Stripe → Développeurs → Webhooks → endpoint https://TON-SITE/api/webhook
# événement : checkout.session.completed
STRIPE_WEBHOOK_SECRET="whsec_..."

# Adresse du site en ligne (pour le retour après paiement)
APP_URL="https://ton-site.vercel.app"

# E-mails (resend.com) : le domaine de EMAIL_FROM doit être vérifié dans Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="ALL Saison <noreply@all-tempalte.fr>"
# Où tu reçois les nouvelles commandes à passer sur Amazon
ORDER_NOTIFY_EMAIL="alltemplate33@gmail.com"

# Supabase (optionnel) : historique des commandes, voir supabase/commandes.sql
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SECRET_KEY="..."
